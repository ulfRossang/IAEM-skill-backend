<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="epatraktorPU" transaction-type="JTA">
    <jta-data-source>jdbc/epatraktor</jta-data-source>

    <class>se.handelsbanken.iaem.meddelanden.entity.Meddelandetyp</class>
    <class>se.handelsbanken.iaem.meddelanden.entity.Meddelandestatus</class>
    <class>se.handelsbanken.iaem.meddelanden.entity.Fragekategori</class>
    <class>se.handelsbanken.iaem.meddelanden.entity.MeddelandeHeader</class>
    <class>se.handelsbanken.iaem.meddelanden.entity.Meddelandetext</class>
    <class>se.handelsbanken.iaem.meddelanden.entity.Bilaga</class>
    <class>se.handelsbanken.iaem.meddelanden.entity.Bilagekoppling</class>
    <class>se.handelsbanken.iaem.kunder.entity.KundEntity</class>
    <class>se.handelsbanken.iaem.utskick.entity.UtskickEntity</class>
    <class>se.handelsbanken.iaem.utskick.entity.UtskickBilagaEntity</class>
    <class>se.handelsbanken.iaem.utskick.entity.UtskickInstallningEntity</class>
    <class>se.handelsbanken.iaem.dokument.entity.DokumentEntity</class>
    <class>se.handelsbanken.iaem.kuvert.entity.KuvertEntity</class>
    <class>se.handelsbanken.iaem.publicering.entity.InformationssambandEntity</class>
    <class>se.handelsbanken.iaem.publicering.entity.PubliceringJobbEntity</class>
    <class>se.handelsbanken.iaem.informationsprodukter.entity.InformationsproduktEntity</class>
    <class>se.handelsbanken.iaem.debiteringsuppgifter.entity.DebiteringsuppgiftEntity</class>
    <class>se.handelsbanken.iaem.massutskick.entity.MassutskickEntity</class>

    <exclude-unlisted-classes>true</exclude-unlisted-classes>

    <properties>
      <!-- H2 2.x: DDL from custom H2 2.x-compatible SQL scripts (AUTO_INCREMENT, not BIGINT IDENTITY) -->
      <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
      <property name="jakarta.persistence.schema-generation.create-source" value="script"/>
      <property name="jakarta.persistence.schema-generation.drop-source" value="script"/>
      <property name="jakarta.persistence.schema-generation.create-script-source" value="META-INF/create-h2.sql"/>
      <property name="jakarta.persistence.schema-generation.drop-script-source" value="META-INF/drop-h2.sql"/>
      <!-- Custom platform: overrides CALL IDENTITY() → CALL LAST_INSERT_ID() for H2 2.x -->
      <property name="eclipselink.target-database" value="se.handelsbanken.iaem.H2V2Platform"/>
    </properties>
  </persistence-unit>
</persistence>
