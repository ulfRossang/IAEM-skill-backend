<?xml version="1.0" encoding="UTF-8"?>
<server description="IAEM Kontakten Backend (H2 in-memory)">
  <featureManager>
    <feature>restfulWS-3.1</feature>
    <feature>jsonb-3.0</feature>
    <feature>cdi-4.0</feature>
    <feature>mpOpenAPI-3.1</feature>
    <feature>persistence-3.1</feature>
  </featureManager>

  <httpEndpoint id="defaultHttpEndpoint"
                httpPort="9080"
                httpsPort="9443"/>

  <!-- H2 in-memory database – schema EPATRAKTOR created via INIT, kept alive with DB_CLOSE_DELAY=-1 -->
  <dataSource id="epatraktorDS" jndiName="jdbc/epatraktor">
    <jdbcDriver libraryRef="h2Lib"/>
    <properties url="jdbc:h2:mem:epatraktor;DB_CLOSE_DELAY=-1;MODE=MySQL;INIT=CREATE SCHEMA IF NOT EXISTS EPATRAKTOR"
                user="sa"
                password=""/>
  </dataSource>

  <library id="h2Lib">
    <fileset dir="${server.config.dir}/lib" includes="h2-*.jar"/>
  </library>

  <!-- third-party visibility lets the app extend EclipseLink classes (e.g. H2V2Platform extends H2Platform) -->
  <!-- commonLibraryRef exposes H2 classes to the app so WebServlet (h2-console) can load -->
  <webApplication location="iaem-backend.war" contextRoot="/iaem">
    <classloader commonLibraryRef="h2Lib" apiTypeVisibility="spec, ibm-api, api, stable, beta, third-party"/>
  </webApplication>

  <logging consoleLogLevel="INFO"/>
</server>
